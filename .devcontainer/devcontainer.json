{
  "name": "prosekit-utilities",
  // The Vite+ base image: Node + pnpm + the vp CLI. The tag is the catalog's
  // `vite-plus` pin (pnpm-workspace.yaml); move it in the same PR that bumps
  // vite-plus, since Dependabot's devcontainers updates cover only the features.
  // The Dev Container workflow fails when the two differ.
  "image": "ghcr.io/voidzero-dev/vite-plus:1.6.0",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Exact feature and tool versions: with `latest` the feature resolves the
    // newest GitHub release at build time, so a build can change (or fail)
    // with nothing in this repository changing.
    "ghcr.io/devcontainers-extra/features/ripgrep:1.0.15": { "version": "15.2.0" },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainer-community/devcontainer-features/jq:1": {}
  },
  // Same provisioning as an agent session: the pinned Vite+ CLI, vp/vpx links,
  // the frozen install and `svelte-kit sync` (see that file's header). Its
  // Chromium bridge needs the session image's /opt/pw-browsers and is skipped
  // here, so the browser suites get the revision the pinned `playwright`
  // expects from its own download instead, as in CI.
  "postCreateCommand": "bash .claude/hooks/session-start.sh && pnpm exec playwright install --with-deps chromium",
  // Storybook's dev server (`vp run --filter ./packages/prosekit-svelte storybook`).
  "forwardPorts": [6006],
  "customizations": {
    "vscode": {
      "extensions": [
        "svelte.svelte-vscode",
        "bradlc.vscode-tailwindcss",
        "Anthropic.claude-code",
        "oxc.oxc-vscode"
      ]
    }
  },
  "workspaceFolder": "/workspaces/prosekit-utilities"
}
