{
  "name": "prosekit-utilities",
  // The tag must equal the catalog's `vite-plus` pin (the Dev Container
  // workflow checks it); Dependabot does not move it.
  "image": "ghcr.io/voidzero-dev/vite-plus:1.6.0",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers-extra/features/ripgrep:1.0.15": { "version": "15.2.0" },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainer-community/devcontainer-features/jq:1": {}
  },
  "postCreateCommand": "vp install --frozen-lockfile && vp exec playwright install --with-deps chromium",
  // Storybook's dev server (`vp run --filter ./packages/prosekit-svelte storybook`).
  "forwardPorts": [6006],
  "customizations": {
    "vscode": {
      "extensions": [
        "svelte.svelte-vscode",
        "bradlc.vscode-tailwindcss",
        "Anthropic.claude-code",
        "oxc.oxc-vscode"
      ]
    }
  },
  "workspaceFolder": "/workspaces/prosekit-utilities"
}
