.DS_Store
node_modules
.pnpm-store

# Env files — nothing here needs one, but keep the guard.
.env
.env.*
!.env.example

# SvelteKit codegen (`svelte-kit sync`).
.svelte-kit/

# @sveltejs/package output — the published artifact, rebuilt from source.
dist/

# Storybook static build output.
storybook-static/

# `pnpm pack` output — the release path packs each package to `package.tgz`
# before `npm publish`; a local dry run leaves the same file behind.
*.tgz

# Vitest coverage reports.
coverage/

# Vite / Vitest scratch.
vite.config.*.timestamp*
*.tsbuildinfo

# Local Claude Code state.
.claude/settings.local.json
.claude/worktrees/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
.vitest/
