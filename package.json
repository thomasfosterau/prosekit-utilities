{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/prosekit-utilities-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "ProseKit document grammars as Effect Schemas, Drizzle document columns, and Svelte 5 editor components — in a Vite+ workspace",
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/prosekit-utilities.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint",
    "changeset": "changeset",
    "fallow": "fallow --summary",
    "fallow:audit": "fallow audit",
    "version": "changeset version && vp fmt",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@thomasfosterau/prosekit-flowchart": "workspace:*",
    "@thomasfosterau/prosekit-svelte": "workspace:*",
    "@thomasfosterau/prosekit-utilities": "workspace:*"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@effect/tsgo": "catalog:",
    "@enfect/oxlint": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "fallow": "catalog:",
    "svelte": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.26.0"
}
