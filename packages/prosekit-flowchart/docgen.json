{
  "$schema": "../../node_modules/@effect/docgen/schema.json",
  "srcLink": "https://github.com/thomasfosterau/prosekit-utilities/blob/trunk/packages/prosekit-flowchart/src/lib/",
  "srcDir": "src/lib",
  "outDir": "docs/api",
  "enforceVersion": false,
  "runExamples": false,
  "exclude": ["src/lib/**/*.test.ts", "src/lib/**/*.test-d.ts", "src/lib/internal/**"],
  "parseCompilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "allowImportingTsExtensions": true
  },
  "tscExecutable": "true"
}
