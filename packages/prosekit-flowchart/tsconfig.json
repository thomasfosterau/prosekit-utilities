{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `vite/client` for the ambient module declarations that let a component
    // import a stylesheet for its side effect; those are Vite's, not Node's.
    "types": ["node", "vite/client"],
    // For oxlint-tsgolint (type-aware `vp lint`, which reads each file's
    // nearest tsconfig.json) and editors: the sibling packages resolve to
    // their `src/`, so lint types them on a clean tree, before any `build`.
    // The check and build gates resolve them through their published
    // `exports` (the built `dist/`) instead: `tsconfig.dist.json` clears
    // these paths.
    "paths": {
      "@thomasfosterau/prosekit-utilities": ["../prosekit-utilities/src/index.ts"],
      "@thomasfosterau/prosekit-utilities/derive": ["../prosekit-utilities/src/derive/index.ts"],
      "@thomasfosterau/prosekit-utilities/prosekit": [
        "../prosekit-utilities/src/prosekit/index.ts"
      ],
      "@thomasfosterau/prosekit-utilities/drizzle": ["../prosekit-utilities/src/drizzle/index.ts"],
      "@thomasfosterau/prosekit-svelte": ["../prosekit-svelte/src/lib/index.ts"]
    }
  },
  "include": ["src", "tests"]
}
