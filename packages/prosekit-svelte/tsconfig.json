{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `vite/client` for the ambient module declarations that let a component
    // import a stylesheet for its side effect; those are Vite's, not Node's.
    "types": ["node", "vite/client"]
  },
  // `.storybook/**/*.ts`, not a bare `.storybook`: TypeScript expands a bare
  // `include` entry to a directory only when its last segment holds no `.`,
  // `*` or `?`, so `.storybook` alone names a file that doesn't exist and the
  // Storybook config would go unchecked.
  "include": ["src", "tests", ".storybook/**/*.ts"]
}
