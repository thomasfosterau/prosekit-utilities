{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/prosekit-utilities",
  "version": "0.1.0",
  "description": "ProseKit document grammars as Effect Schemas: browser-cheap document shapes, node/mark allow-lists, an Effect Schema derived from a compiled ProseMirror schema, HTML and Markdown serialisation, and Drizzle jsonb document columns",
  "keywords": [
    "drizzle",
    "editor",
    "effect",
    "effect-schema",
    "prosekit",
    "prosemirror",
    "rich-text"
  ],
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/prosekit-utilities.git",
    "directory": "packages/prosekit-utilities"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./derive": {
      "types": "./dist/derive.d.ts",
      "default": "./dist/derive.js"
    },
    "./prosekit": {
      "types": "./dist/prosekit.d.ts",
      "default": "./dist/prosekit.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "default": "./dist/drizzle.js"
    }
  },
  "devDependencies": {
    "@prosekit/pm": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "happy-dom": "catalog:",
    "linkedom": "catalog:",
    "prosekit": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@prosekit/pm": "^0.1.19",
    "drizzle-orm": "^1.0.0-rc.5",
    "effect": ">=4.0.0-rc.118",
    "linkedom": "^0.18.13",
    "prosekit": "^0.22.2"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "linkedom": {
      "optional": true
    }
  }
}
